<?xml version="1.0" encoding="UTF-8"?>
<!--
  Meeting Hours Guard: an Outlook Smart Alerts add-in (add-in only XML manifest).
  Dev build: everything is served from https://emrahalpat.github.io/meeting-hours-guard (npm start).
  For production, replace every https://emrahalpat.github.io/meeting-hours-guard with your HTTPS host.
-->
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
           xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.0"
           xsi:type="MailApp">
  <Id>05aa173c-b018-4229-b1c2-a3706708b386</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>Internal IT</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="Meeting Hours Guard"/>
  <Description DefaultValue="Warns organizers when a meeting falls outside company meeting hours (Mon to Fri, 10:00 to 18:30)."/>
  <IconUrl DefaultValue="https://emrahalpat.github.io/meeting-hours-guard/assets/icon-64.png"/>
  <HighResolutionIconUrl DefaultValue="https://emrahalpat.github.io/meeting-hours-guard/assets/icon-128.png"/>
  <SupportUrl DefaultValue="https://emrahalpat.github.io/meeting-hours-guard/support.html"/>
  <AppDomains>
    <AppDomain>https://emrahalpat.github.io</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Mailbox"/>
  </Hosts>
  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.1"/>
    </Sets>
  </Requirements>
  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://emrahalpat.github.io/meeting-hours-guard/commands.html"/>
        <RequestedHeight>250</RequestedHeight>
      </DesktopSettings>
    </Form>
  </FormSettings>
  <Permissions>ReadWriteItem</Permissions>
  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Read"/>
  </Rule>
  <DisableEntityHighlighting>false</DisableEntityHighlighting>

  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
    <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides/1.1" xsi:type="VersionOverridesV1_1">
      <Requirements>
        <bt:Sets DefaultMinVersion="1.12">
          <bt:Set Name="Mailbox"/>
        </bt:Sets>
      </Requirements>
      <Hosts>
        <Host xsi:type="MailHost">
          <Runtimes>
            <!-- Web and new Outlook load the HTML page; classic Outlook on Windows loads the JS file. -->
            <Runtime resid="WebViewRuntime.Url">
              <Override type="javascript" resid="JSRuntime.Url"/>
            </Runtime>
          </Runtimes>
          <DesktopFormFactor>
            <FunctionFile resid="WebViewRuntime.Url"/>

            <!-- Ribbon button in the meeting form: check the hours on demand. -->
            <ExtensionPoint xsi:type="AppointmentOrganizerCommandSurface">
              <OfficeTab id="TabDefault">
                <Group id="mhgGroup">
                  <Label resid="GroupLabel"/>
                  <Control xsi:type="Button" id="mhgCheckButton">
                    <Label resid="CheckButton.Label"/>
                    <Supertip>
                      <Title resid="CheckButton.Label"/>
                      <Description resid="CheckButton.Tooltip"/>
                    </Supertip>
                    <Icon>
                      <bt:Image size="16" resid="Icon.16x16"/>
                      <bt:Image size="32" resid="Icon.32x32"/>
                      <bt:Image size="80" resid="Icon.80x80"/>
                    </Icon>
                    <Action xsi:type="ExecuteFunction">
                      <FunctionName>checkMeetingHours</FunctionName>
                    </Action>
                  </Control>
                </Group>
              </OfficeTab>
            </ExtensionPoint>

            <!-- Event-based activation. SendMode: PromptUser (Send Anyway allowed), SoftBlock, or Block. -->
            <ExtensionPoint xsi:type="LaunchEvent">
              <LaunchEvents>
                <LaunchEvent Type="OnNewAppointmentOrganizer" FunctionName="onAppointmentChangedHandler"/>
                <LaunchEvent Type="OnAppointmentTimeChanged" FunctionName="onAppointmentChangedHandler"/>
                <LaunchEvent Type="OnAppointmentAttendeesChanged" FunctionName="onAppointmentChangedHandler"/>
                <LaunchEvent Type="OnAppointmentSend" FunctionName="onAppointmentSendHandler" SendMode="PromptUser"/>
              </LaunchEvents>
              <SourceLocation resid="WebViewRuntime.Url"/>
            </ExtensionPoint>
          </DesktopFormFactor>
        </Host>
      </Hosts>
      <Resources>
        <bt:Images>
          <bt:Image id="Icon.16x16" DefaultValue="https://emrahalpat.github.io/meeting-hours-guard/assets/icon-16.png"/>
          <bt:Image id="Icon.32x32" DefaultValue="https://emrahalpat.github.io/meeting-hours-guard/assets/icon-32.png"/>
          <bt:Image id="Icon.80x80" DefaultValue="https://emrahalpat.github.io/meeting-hours-guard/assets/icon-80.png"/>
        </bt:Images>
        <bt:Urls>
          <bt:Url id="WebViewRuntime.Url" DefaultValue="https://emrahalpat.github.io/meeting-hours-guard/commands.html"/>
          <bt:Url id="JSRuntime.Url" DefaultValue="https://emrahalpat.github.io/meeting-hours-guard/commands.js"/>
        </bt:Urls>
        <bt:ShortStrings>
          <bt:String id="GroupLabel" DefaultValue="Meeting Hours"/>
          <bt:String id="CheckButton.Label" DefaultValue="Check hours"/>
        </bt:ShortStrings>
        <bt:LongStrings>
          <bt:String id="CheckButton.Tooltip" DefaultValue="Check this meeting against company meeting hours (Mon to Fri, 10:00 to 18:30)."/>
        </bt:LongStrings>
      </Resources>
    </VersionOverrides>
  </VersionOverrides>
</OfficeApp>
